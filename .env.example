# ============================================================================
#  ZERO-COST DEFAULT — no credit card, nothing to sign up for except Groq
# ============================================================================
# Embeddings run locally (no key at all). Generation uses Groq's free tier,
# which is the only free tier whose contract bars training on your data.

LLM_PROVIDER=groq
EMBED_PROVIDER=local

# Groq — free, no card. https://console.groq.com/keys
# 30 req/min, 1,000 req/day on llama-3.3-70b-versatile.
GROQ_API_KEY=...
GROQ_MODEL=llama-3.3-70b-versatile

# Local embeddings — no key. First build downloads ~65 MB to ~/.cache/fastembed.
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
#  ALTERNATIVES
# ---------------------------------------------------------------------------

# Voyage — 200M free tokens on signup, best hosted embedding quality.
# https://dashboard.voyageai.com/    Their data-use position is not published:
# fine for this demo's synthetic data, get it in writing before client docs.
# EMBED_PROVIDER=voyage
VOYAGE_API_KEY=...
# VOYAGE_MODEL=voyage-4-lite

# Gemini — free of charge for both embedding and generation.
# https://aistudio.google.com/apikey
# WARNING: Google's terms say free-tier input AND output are used to improve
# their products, and human reviewers may read them. Their docs say outright:
# "Do not submit sensitive, confidential, or personal information to the
# Unpaid Services." Synthetic demo data only — never a client's documents.
# Adding $5 of billing moves you to the paid tier where this does not apply.
# LLM_PROVIDER=gemini
# EMBED_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama — fully local generation, no key, no network. Slower.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# Anthropic — best quality, no free tier (~$5 minimum credit).
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI embeddings — no free tier, $5 minimum.
# EMBED_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional reranker — biggest single retrieval-quality lever.
# Cohere trial keys are free but capped at 1,000 calls/month, and their trial
# terms allow using your data. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...

# ---------------------------------------------------------------------------
DEMO_SEGMENT=accountant
MIN_RERANK_SCORE=0.28
